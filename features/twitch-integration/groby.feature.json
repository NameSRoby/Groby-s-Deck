{
  "schemaVersion": 1,
  "id": "twitch-integration",
  "name": "Twitch Integration",
  "description": "Optional Twitch Device Code authorization, redemption settlement, EventSub foundation, and chat transport.",
  "version": "0.12.59",
  "publisher": "grobys-deck",
  "entry": "dist/main.js",
  "engine": {
    "featureApi": "^1.0.0",
    "node": ">=22"
  },
  "consumes": [
    "twitch.host.v1"
  ],
  "provides": [
    "twitch.connection.read.v1",
    "twitch.oauth.admin.v1",
    "twitch.monitor.admin.v1",
    "twitch.rewards.read.v1",
    "twitch.rewards.admin.v1",
    "twitch.redemptions.v1",
    "twitch.chat.send.v1",
    "twitch.rewards.catalog.v1",
    "twitch.automations.v1"
  ],
  "contracts": [
    "contracts/twitch-integration-v1.contracts.json",
    "contracts/twitch-automations-v1.contracts.json"
  ],
  "permissions": {
    "network": [
      "id.twitch.tv",
      "api.twitch.tv",
      "eventsub.wss.twitch.tv"
    ],
    "storage": false,
    "secrets": [
      "twitch.oauth.tokens"
    ],
    "process": false,
    "hardware": []
  },
  "resources": {
    "idleCpuPercent": 0.75,
    "idleRssMiB": 64,
    "activeRssMiB": 256,
    "timers": 1,
    "minTimerMs": 1000,
    "ipcFrameBytes": 524288,
    "inFlightCalls": 2,
    "queuedCalls": 4,
    "externalInFlight": 1,
    "storageBytes": 0,
    "historyEntries": 128,
    "shutdownGraceMs": 3000
  },
  "contributes": {
